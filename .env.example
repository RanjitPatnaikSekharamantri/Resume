DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_career_os?schema=public"
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
SUPABASE_URL="your-supabase-url"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
OPENAI_API_KEY="your-openai-api-key"

# Optional: set a maximum number of users (omit for unlimited)
# MAX_USERS=50

# Email verification (Resend provider — omit to disable email verification)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM="AI Career OS <noreply@yourdomain.com>"
# Or set this to "true" to enable verification with console-logged links (dev mode)
# ENABLE_EMAIL_VERIFICATION=true

# Cloudflare Turnstile CAPTCHA (omit to disable CAPTCHA)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
