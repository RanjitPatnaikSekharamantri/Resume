generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile        Profile?
  accounts       Account[]
  sessions       Session[]
  baseResumes    BaseResume[]
  applications   Application[]
  aiProviders    AIProvider[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                String  @id @default(cuid())
  userId            String  @unique
  phone             String?
  location          String?
  linkedIn          String?
  website           String?
  github            String?
  portfolio         String?
  workAuthorization String?
  veteranStatus     String?
  disabilityStatus  String?
  ethnicity         String?
  gender            String?
  preferredRole     String?
  preferredLocation String?
  salaryExpectation String?
  remotePreference  String?
  summary           String? @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BaseResume {
  id           String   @id @default(cuid())
  userId       String
  name         String
  fileName     String
  fileUrl      String
  fileType     String
  roleCategory String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersions  ResumeVersion[]
}

model Application {
  id             String   @id @default(cuid())
  userId         String
  jobTitle       String
  company        String
  location       String?
  salary         String?
  postedDate     DateTime?
  jobDescription String?  @db.Text
  jobUrl         String?
  source         String?
  notes          String?  @db.Text
  status         String   @default("not_applied")
  matchScore     Int?
  skillsMatch    Int?
  experienceMatch Int?
  keywordCoverage Int?
  domainMatch    Int?
  followUpDate   DateTime?
  reminderEnabled Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersions    ResumeVersion[]
  coverLetters      CoverLetterVersion[]
  activities        Activity[]

  @@index([userId, status])
  @@index([userId, updatedAt])
}

model ResumeVersion {
  id            String   @id @default(cuid())
  applicationId String
  baseResumeId  String?
  jobTitle      String
  company       String
  version       Int      @default(1)
  fileName      String
  fileUrl       String
  content       String?  @db.Text
  isTailored    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  baseResume  BaseResume? @relation(fields: [baseResumeId], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

model CoverLetterVersion {
  id            String   @id @default(cuid())
  applicationId String
  jobTitle      String
  company       String
  version       Int      @default(1)
  content       String   @db.Text
  fileName      String?
  fileUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Activity {
  id            String   @id @default(cuid())
  applicationId String
  type          String
  description   String
  metadata      String?  @db.Text
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model AIProvider {
  id        String   @id @default(cuid())
  userId    String
  name      String
  apiKey    String
  model     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
