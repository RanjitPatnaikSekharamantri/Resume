generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  NOT_APPLIED
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  ARCHIVED
}

enum AIProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
  AZURE
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             Profile?
  baseResumes         BaseResume[]
  applications        Application[]
  resumeVersions      ResumeVersion[]
  coverLetterVersions CoverLetterVersion[]
  aiProviders         AIProvider[]
  accounts            Account[]
  sessions            Session[]
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  phone               String?
  location            String?
  linkedin            String?
  links               String[]
  workAuthorization   String?
  equalOpportunity    Json?
  preferences         Json?
  summary             String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BaseResume {
  id            String          @id @default(cuid())
  userId        String
  roleCategory  String
  fileName      String
  mimeType      String
  storagePath   String
  pageCount     Int?
  parsedText    String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersions ResumeVersion[]

  @@index([userId, roleCategory])
}

model Application {
  id                  String               @id @default(cuid())
  userId              String
  jobTitle            String
  company             String
  location            String?
  salary              String?
  postedDate          DateTime?
  jobDescription      String?              @db.Text
  jobUrl              String?
  source              String?
  notes               String?              @db.Text
  status              ApplicationStatus    @default(SAVED)
  matchScore          Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersions      ResumeVersion[]
  coverLetterVersions CoverLetterVersion[]
  activities          ApplicationActivity[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model ResumeVersion {
  id            String       @id @default(cuid())
  userId        String
  applicationId String?
  baseResumeId  String?
  jobTitle      String
  company       String
  version       Int          @default(1)
  fileName      String
  mimeType      String
  storagePath   String?
  content       String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  baseResume    BaseResume?  @relation(fields: [baseResumeId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([userId, createdAt])
}

model CoverLetterVersion {
  id            String       @id @default(cuid())
  userId        String
  applicationId String?
  jobTitle      String
  company       String
  version       Int          @default(1)
  content       String       @db.Text
  storagePath   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([userId, createdAt])
}

model ApplicationActivity {
  id            String      @id @default(cuid())
  applicationId String
  type          String
  message       String
  metadata      Json?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model AIProvider {
  id              String         @id @default(cuid())
  userId          String
  provider        AIProviderType
  encryptedApiKey String
  keyHint         String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
